extends SceneTree

## Rewrites zz_weapon_measures.gd from the models, so startup reads numbers instead of loading every glb. Run
## after a model or a TABLE row changes (the selftest fails while the file is stale):
## heavy -- godot --headless --path . --script res://tools/bake_measures.gd

const OUT := "res://addons/zz_modern_weapons/zz_weapon_measures.gd"


func _init() -> void:
	var lines: PackedStringArray = [
		"## Generated by tools/bake_measures.gd from the models: never edit by hand. ZzWeaponArt.measures reads a row",
		"## while its model is the TABLE's; the selftest fails when a row is stale.",
		"",
		"const MEASURES := {",
	]
	var ids: Array = ZzWeaponArt.TABLE.keys()
	ids.sort_custom(func(a: StringName, b: StringName) -> bool: return String(a) < String(b))
	var rows := 0
	for id: StringName in ids:
		var m := ZzWeaponArt.measure(id)
		if m.is_empty():
			continue
		rows += 1
		lines.append("\t&\"%s\": {" % id)
		lines.append("\t\t\"model\": \"%s\"," % m["model"])
		if m.has("tip"):
			lines.append("\t\t\"tip\": %s," % _vec(m["tip"]))
		lines.append("\t\t\"sight\": %s," % _vec(m["sight"]))
		lines.append("\t\t\"sockets\": {")
		var mounts: Array = (m["sockets"] as Dictionary).keys()
		mounts.sort()
		for mount: String in mounts:
			lines.append("\t\t\t\"%s\": %s," % [mount, _vec(m["sockets"][mount])])
		lines.append("\t\t},")
		lines.append("\t},")
	lines.append("}")
	var f := FileAccess.open(OUT, FileAccess.WRITE)
	if f == null:
		push_error("cannot write %s: %s" % [OUT, error_string(FileAccess.get_open_error())])
		quit(1)
		return
	f.store_string("\n".join(lines) + "\n")
	f.close()
	print("bake_measures: wrote %d rows to %s" % [rows, OUT])
	quit()


## Full precision, so the baked point is the measured float exactly.
func _vec(v: Vector3) -> String:
	return "Vector3(%s, %s, %s)" % [var_to_str(v.x), var_to_str(v.y), var_to_str(v.z)]
